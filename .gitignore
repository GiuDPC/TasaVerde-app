# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# typescript
*.tsbuildinfo

# Android (Kotlin) — build artifacts / machine-specific (no el código fuente)
android/.gradle/
android/.kotlin/
android/**/build/
android/local.properties

# agent tooling (gentle-ai / local skill caches)
.atl/
.agente/
.agent/
# Testing
coverage/
__snapshots__/
.jest/
